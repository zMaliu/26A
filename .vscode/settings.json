{
    "latex-workshop.latex.tools": [
        {
            "name": "xelatex-local",
            "command": "D:/texlive2023/texlive/2023/bin/windows/xelatex.exe",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "bibtex",
            "command": "D:/texlive2023/texlive/2023/bin/windows/bibtex.exe",
            "args": ["%DOCFILE%"]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "XeLaTeX",
            "tools": ["xelatex-local"]
        },
        {
            "name": "XeLaTeX + BibTeX",
            "tools": ["xelatex-local", "bibtex", "xelatex-local", "xelatex-local"]
        }
    ],
    "latex-workshop.latex.recipe.default": "XeLaTeX",
    "latex-workshop.latex.outDir": "%DIR%/output/pdf",
    "latex-workshop.view.pdf.viewer": "tab"
}
